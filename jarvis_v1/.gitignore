# Project-level ignores for jarvis_v1/.
# The repo root is one level up (C:/CSE_Projects/JARVIS), so slash-anchored
# patterns in the root .gitignore do NOT apply to this subdirectory. These do.

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# data/ mixes SOURCE (the FineWeb index builder + its blocklists, which must be
# tracked) with RUNTIME data (SQLite history, Chroma vectors, vault index, web
# RAG index, screenshots, the file-tool sandbox). Ignore everything in it, then
# re-include only the source. Ignoring the whole directory previously kept the
# builder out of git, so fresh clones (and CI) couldn't import data.*.
data/*
!data/*.py
!data/blocklists/
!data/workspace/
data/workspace/*
!data/workspace/.gitkeep

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite3

# Conversation / memory DATA (not the memory/ source package)
data/memory/
data/vault_index/
data/web_index/

# Piper ONNX voice models (60-120 MB each) — download per README, never commit
voices/*.onnx
voices/*.onnx.json
voices/cache/

# Screenshots / generated
data/screenshots/
screenshots/
outputs/
generated/

# Local model weights
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

# Logs / caches
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local tooling / editor state
.claude/settings.local.json
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
