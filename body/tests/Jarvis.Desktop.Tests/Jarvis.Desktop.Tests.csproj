<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop actions without touching the real desktop: allowlist, UI-tree
       trimming, and request handlers over fake window/launch/volume/UIA backends.
       Results are validated against the shared protocol/ response schemas. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- FlaUiActorTests drive a small WinForms window of their own. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Jarvis.Desktop\Jarvis.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The allowlist the Body actually ships, so tests check the real file. -->
    <None Include="..\..\src\Jarvis.Body\desktop.allowlist.json" Link="desktop.allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
