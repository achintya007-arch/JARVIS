<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native desktop actions for the Body (BBP desktop.*): windows, app launch,
       Core Audio volume, UI Automation reading. Every action is gated by the
       Body's own allowlist (desktop.allowlist.json), independent of the Brain. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Jarvis.Desktop</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The risky-word list shared with the Brain (BBP amendment 20). -->
    <None Include="..\..\..\protocol\policy\risky-words.json" Link="risky-words.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bbp.Client\Bbp.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Desktop.Tests" />
  </ItemGroup>
</Project>
