<Project Sdk="Microsoft.NET.Sdk">
  <!-- JARVIS Body: the Windows HUD. All protocol and networking code lives in
       Bbp.Client; this project is UI only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); everything else is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Jarvis.Body</AssemblyName>
    <RootNamespace>Jarvis.Body</RootNamespace>
    <Version>0.6.0</Version>
    <!-- Made by body/tools/make-icon.ps1 (exe, shortcuts, windows). -->
    <ApplicationIcon>jarvis.ico</ApplicationIcon>
    <Product>JARVIS</Product>
  </PropertyGroup>
  <!-- install.ps1 publishes one framework-dependent exe (needs the .NET 8+
       Desktop Runtime; a few MB instead of ~150 MB self-contained). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms/System.Drawing names clash with WPF ones (Application,
         MessageBox, Color, Brush…); reference them explicitly instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Body.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bbp.Client\Bbp.Client.csproj" />
    <ProjectReference Include="..\Jarvis.Desktop\Jarvis.Desktop.csproj" />
    <ProjectReference Include="..\Jarvis.Launcher\Jarvis.Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="body.settings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="desktop.allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
